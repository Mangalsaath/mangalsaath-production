# MangalSaath v1.6.2 Final Launch Candidate — Hostinger production
# Technical/runtime configuration only. Never commit real secrets.
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://your-domain.com
DATABASE_URL="mysql://DB_USER:URL_ENCODED_DB_PASSWORD@DB_HOST:3306/DB_NAME"
JSON_DATABASE_PATH=./data/db.json
FORCE_JSON_IMPORT=false
APP_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
ALLOW_DEMO_OTP=false
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-mailbox@your-domain.com
SMTP_PASS="REPLACE_WITH_ADMIN_MAILBOX_PASSWORD"
DEFAULT_FROM_EMAIL=your-mailbox@your-domain.com
MAIL_FROM_NAME=MangalSaath
MAIL_REPLY_TO=support@mangalsaath.com
AUTH_STORAGE_MODE=relational
PROFILE_STORAGE_MODE=relational
COMMUNICATION_STORAGE_MODE=relational
ADMIN_STORAGE_MODE=relational
FEATURE_EMAIL_OTP=true
FEATURE_MOBILE_OTP=false
FEATURE_MANUAL_MOBILE_VERIFICATION=true
PAYMENT_ENGINE_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ONE-TIME FIRST INSTALL ONLY. Remove after the first Super Admin is created.
ADMIN_USERNAME=your-mailbox@your-domain.com
ADMIN_EMAIL=your-mailbox@your-domain.com
ADMIN_FIRST_NAME=Super
ADMIN_LAST_NAME=Admin
ADMIN_MOBILE=REPLACE_WITH_10_DIGIT_MOBILE
ADMIN_PASSWORD="REPLACE_WITH_STRONG_TEMPORARY_PASSWORD"
ADMIN_SECURITY_QUESTION="REPLACE_WITH_PRIVATE_SECURITY_QUESTION"
ADMIN_SECURITY_ANSWER="REPLACE_WITH_PRIVATE_SECURITY_ANSWER"
ADMIN_RESET_PASSWORD=false
