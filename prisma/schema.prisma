generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Transitional compatibility store. It remains the runtime source of truth
/// until the relational cutover has passed count and behaviour verification.
model ApplicationState {
  id        Int      @id @default(1)
  payload   Json
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("application_state")
}

/// v6.5.0 relational core. String IDs preserve the IDs already used by the app.
model User {
  id                  String    @id @db.VarChar(64)
  username            String?   @unique @db.VarChar(120)
  firstName           String    @db.VarChar(80)
  lastName            String    @db.VarChar(80)
  email               String    @unique @db.VarChar(191)
  mobile              String    @unique @db.VarChar(20)
  passwordHash        String    @db.VarChar(255)
  role                String    @default("member") @db.VarChar(24)
  status              String    @default("active") @db.VarChar(24)
  city                String?   @db.VarChar(120)
  profession          String?   @db.VarChar(160)
  membership          String    @default("Free") @db.VarChar(60)
  membershipPlanId    String    @default("free") @db.VarChar(64)
  mobileVerified                Boolean   @default(false)
  mobileVerificationStatus      String    @default("pending") @db.VarChar(24)
  mobileVerificationMethod      String?   @db.VarChar(24)
  mobileVerifiedBy              String?   @db.VarChar(64)
  mobileVerifiedAt              DateTime?
  emailVerified                 Boolean   @default(false)
  verified                      Boolean   @default(false)
  approvalStatus                String    @default("pending") @db.VarChar(24)
  approvedBy                    String?   @db.VarChar(64)
  approvedAt                    DateTime?
  approvalReason                String?   @db.Text
  mustChangePassword  Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  termsAcceptedAt     DateTime?
  passwordChangedAt   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  profile              MemberProfile?
  sessions             SessionRecord[]
  sentInterests        InterestRecord[] @relation("InterestSender")
  receivedInterests    InterestRecord[] @relation("InterestRecipient")
  sentMessages         MessageRecord[]  @relation("MessageSender")
  receivedMessages     MessageRecord[]  @relation("MessageRecipient")
  blocksCreated        BlockRecord[]    @relation("Blocker")
  blocksReceived       BlockRecord[]    @relation("Blocked")
  reportsCreated       ReportRecord[]   @relation("Reporter")
  reportsReceived      ReportRecord[]   @relation("ReportedUser")
  memberships          UserMembership[]
  paymentTransactions  PaymentTransaction[]
  couponRedemptions    CouponRedemption[]
  adminNotes           AdminMemberNote[] @relation("MemberNotes")
  notesAuthored        AdminMemberNote[] @relation("AdminAuthoredNotes")

  @@index([role, status])
  @@index([approvalStatus, mobileVerificationStatus])
  @@index([createdAt])
  @@map("users")
}

model MemberProfile {
  id                    String    @id @db.VarChar(64)
  userId                String    @unique @db.VarChar(64)
  name                  String    @db.VarChar(180)
  gender                String?   @db.VarChar(30)
  dateOfBirth           DateTime?
  placeOfBirth          String?   @db.VarChar(180)
  timeOfBirth           String?   @db.VarChar(5)
  age                   Int?
  maritalStatus         String?   @db.VarChar(60)
  height                Int?
  religion              String?   @db.VarChar(80)
  caste                 String?   @db.VarChar(100)
  subCaste              String?   @db.VarChar(100)
  gotra                  String?   @db.VarChar(100)
  education             String?   @db.VarChar(180)
  profession            String?   @db.VarChar(180)
  annualCtc             String?   @db.VarChar(100)
  brothersMarried       Int       @default(0)
  brothersUnmarried     Int       @default(0)
  sistersMarried        Int       @default(0)
  sistersUnmarried      Int       @default(0)
  country               String?   @db.VarChar(100)
  state                 String?   @db.VarChar(120)
  city                  String?   @db.VarChar(120)
  about                 String?   @db.Text
  partnerAgeMin         Int       @default(18)
  partnerAgeMax         Int       @default(60)
  partnerReligion       String?   @db.VarChar(100)
  partnerCaste          String?   @db.VarChar(100)
  partnerLocation       String?   @db.VarChar(160)
  partnerMaritalStatus  String?   @db.VarChar(100)
  partnerEducation      String?   @db.VarChar(180)
  partnerProfession     String?   @db.VarChar(180)
  photos                Json?
  primaryPhoto          String?   @db.VarChar(100)
  primaryPhotoData      String?   @db.LongText
  photoModerationStatus String?   @db.VarChar(40)
  photoModerationNote   String?   @db.Text
  score                 Int       @default(0)
  verified              Boolean   @default(false)
  verificationStatus    String    @default("not-requested") @db.VarChar(40)
  trustedProfile        Boolean   @default(false)
  initials              String?   @db.VarChar(12)
  isDemoProfile         Boolean   @default(false)
  demoVisible           Boolean   @default(false)
  demoVisibleFrom       DateTime?
  demoVisibleUntil      DateTime?
  demoCreatedBy         String?   @db.VarChar(64)
  demoLabel             String?   @db.VarChar(80)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gender, city])
  @@index([religion, caste])
  @@index([verificationStatus, trustedProfile])
  @@index([isDemoProfile, demoVisible, demoVisibleUntil])
  @@index([createdAt])
  @@map("member_profiles")
}

model SessionRecord {
  id                   String   @id @db.VarChar(64)
  userId               String   @db.VarChar(64)
  tokenHash            String   @unique @db.Char(64)
  ip                   String?  @db.VarChar(100)
  userAgent            String?  @db.VarChar(500)
  adminDualOtpVerified Boolean  @default(false)
  createdAt            DateTime @default(now())
  lastSeenAt           DateTime @default(now())
  expiresAt            DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model InterestRecord {
  id         String   @id @db.VarChar(64)
  fromUserId String   @db.VarChar(64)
  toUserId   String   @db.VarChar(64)
  profileId  String?  @db.VarChar(64)
  status     String   @default("Pending") @db.VarChar(30)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sender    User @relation("InterestSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  recipient User @relation("InterestRecipient", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([fromUserId, toUserId])
  @@index([toUserId, status, createdAt])
  @@index([fromUserId, status, createdAt])
  @@map("interests")
}

model MessageRecord {
  id         String    @id @db.VarChar(64)
  fromUserId String    @db.VarChar(64)
  toUserId   String    @db.VarChar(64)
  profileId  String?   @db.VarChar(64)
  text       String    @db.Text
  read       Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  sender    User @relation("MessageSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  recipient User @relation("MessageRecipient", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([fromUserId, toUserId, createdAt])
  @@index([toUserId, read, createdAt])
  @@map("messages")
}

model BlockRecord {
  id            String   @id @db.VarChar(64)
  blockerUserId String   @db.VarChar(64)
  blockedUserId String   @db.VarChar(64)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  blocker User @relation("Blocker", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockerUserId, blockedUserId])
  @@index([blockedUserId, active])
  @@map("blocks")
}

model ReportRecord {
  id              String    @id @db.VarChar(64)
  reporterUserId  String    @db.VarChar(64)
  targetUserId    String    @db.VarChar(64)
  targetProfileId String?   @db.VarChar(64)
  category        String    @db.VarChar(60)
  details         String    @db.Text
  status          String    @default("open") @db.VarChar(30)
  reviewedAt      DateTime?
  reviewedBy      String?   @db.VarChar(64)
  resolutionNote  String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  reporter User @relation("Reporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  target   User @relation("ReportedUser", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([targetUserId, status])
  @@index([reporterUserId, status])
  @@map("reports")
}

model RelationalMigrationRun {
  id             String   @id @db.VarChar(64)
  sourceVersion  Int
  status         String   @db.VarChar(30)
  counts         Json
  errorMessage   String?  @db.Text
  startedAt      DateTime @default(now())
  completedAt    DateTime?

  @@index([status, startedAt])
  @@map("relational_migration_runs")
}

/// v6.7.0 Admin Console relational foundation.
model BusinessSetting {
  id        String   @id @db.VarChar(64)
  key       String   @unique @db.VarChar(120)
  category  String   @db.VarChar(60)
  value     Json
  isSecret  Boolean  @default(false)
  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, key])
  @@map("business_settings")
}

model MembershipPlan {
  id           String   @id @db.VarChar(64)
  slug         String   @unique @db.VarChar(80)
  name         String   @db.VarChar(100)
  description  String?  @db.Text
  pricePaise   Int      @default(0)
  durationDays Int      @default(0)
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  badge        String?  @db.VarChar(60)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  features    PlanFeature[]
  couponLinks CouponPlan[]
  payments    PaymentTransaction[]
  memberships UserMembership[]

  @@index([active, displayOrder])
  @@map("membership_plans")
}

model PlanFeature {
  id            String  @id @db.VarChar(64)
  planId        String  @db.VarChar(64)
  permissionKey String  @db.VarChar(120)
  enabled       Boolean @default(false)
  numericLimit  Int?

  plan MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, permissionKey])
  @@index([permissionKey, enabled])
  @@map("plan_features")
}

model Coupon {
  id             String    @id @db.VarChar(64)
  code           String    @unique @db.VarChar(40)
  discountType   String    @db.VarChar(24)
  discountValue  Int
  startsAt       DateTime?
  endsAt         DateTime?
  maxUses        Int       @default(0)
  usesPerUser    Int       @default(1)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  plans      CouponPlan[]
  redemptions CouponRedemption[]

  @@index([active, startsAt, endsAt])
  @@map("coupons")
}

model CouponPlan {
  couponId String @db.VarChar(64)
  planId   String @db.VarChar(64)

  coupon Coupon         @relation(fields: [couponId], references: [id], onDelete: Cascade)
  plan   MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([couponId, planId])
  @@index([planId])
  @@map("coupon_plans")
}

model CouponRedemption {
  id             String   @id @db.VarChar(64)
  couponId       String   @db.VarChar(64)
  userId         String   @db.VarChar(64)
  paymentId      String?  @db.VarChar(64)
  discountPaise  Int
  redeemedAt     DateTime @default(now())

  coupon  Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment PaymentTransaction? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([couponId, redeemedAt])
  @@index([userId, couponId])
  @@map("coupon_redemptions")
}

model PaymentTransaction {
  id                   String    @id @db.VarChar(64)
  userId               String?   @db.VarChar(64)
  planId               String?   @db.VarChar(64)
  gateway              String    @default("manual") @db.VarChar(40)
  gatewayOrderId       String?   @unique @db.VarChar(191)
  gatewayPaymentId     String?   @unique @db.VarChar(191)
  manualReference      String?   @unique @db.VarChar(40)
  proofMime            String?   @db.VarChar(40)
  proofData            String?   @db.LongText
  amountPaise          Int
  discountPaise        Int       @default(0)
  currency             String    @default("INR") @db.Char(3)
  status               String    @default("pending") @db.VarChar(30)
  verificationMetadata Json?
  reviewedBy           String?   @db.VarChar(64)
  reviewedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  plan MembershipPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  membership UserMembership?
  couponRedemptions CouponRedemption[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([planId, status])
  @@map("payment_transactions")
}


model UserMembership {
  id                String    @id @db.VarChar(64)
  userId            String    @db.VarChar(64)
  planId            String    @db.VarChar(64)
  paymentId         String?   @unique @db.VarChar(64)
  status            String    @default("active") @db.VarChar(30)
  startsAt          DateTime
  expiresAt         DateTime?
  cancelledAt       DateTime?
  cancellationNote  String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan    MembershipPlan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  payment PaymentTransaction? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([userId, status, expiresAt])
  @@index([planId, status])
  @@map("user_memberships")
}

model HomepageSection {
  id           String   @id @db.VarChar(64)
  sectionKey   String   @unique @db.VarChar(100)
  content      Json
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  revision     Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, displayOrder])
  @@map("homepage_sections")
}


model AdminMemberNote {
  id          String   @id @db.VarChar(64)
  memberId    String   @db.VarChar(64)
  authorId    String   @db.VarChar(64)
  note        String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  member User @relation("MemberNotes", fields: [memberId], references: [id], onDelete: Cascade)
  author User @relation("AdminAuthoredNotes", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
  @@index([authorId, createdAt])
  @@map("admin_member_notes")
}

model AdminAuditLog {
  id         String   @id @db.VarChar(64)
  actorUserId String?  @db.VarChar(64)
  action     String   @db.VarChar(120)
  entityType String?  @db.VarChar(80)
  entityId   String?  @db.VarChar(64)
  metadata   Json?
  ip         String?  @db.VarChar(100)
  userAgent  String?  @db.VarChar(500)
  createdAt  DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@map("admin_audit_logs")
}

model PhotoModerationEvent {
  id             String   @id @db.VarChar(64)
  profileId      String   @db.VarChar(64)
  photoIdentifier String  @db.VarChar(120)
  moderatorUserId String  @db.VarChar(64)
  action         String   @db.VarChar(30)
  reason         String?  @db.Text
  createdAt      DateTime @default(now())

  @@index([profileId, createdAt])
  @@index([moderatorUserId, createdAt])
  @@map("photo_moderation_events")
}
